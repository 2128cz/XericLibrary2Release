// ==================================================
// Xeric Style Sheet (XSSS) - 默认 UI 样式
// ==================================================
// 规范声明：路径:组件类型/.字段路径 = 值:值类型 @标记:参数
// 未配置实际资源时，不保留空 guid: 或 None 占位声明。

namespace: default

// UnityEngine.UI.Button 的 ColorBlock。
Button:UnityEngine.UI.Button/.colors.normalColor = #FFFFFFFF:UnityEngine.Color
Button:UnityEngine.UI.Button/.colors.highlightedColor = #F5F5F5FF:UnityEngine.Color
Button:UnityEngine.UI.Button/.colors.pressedColor = #C7C7C7FF:UnityEngine.Color
Button:UnityEngine.UI.Button/.colors.selectedColor = #F5F5F5FF:UnityEngine.Color
Button:UnityEngine.UI.Button/.colors.disabledColor = #999999CC:UnityEngine.Color

// UnityEngine.UI.Toggle 的 ColorBlock。
Toggle:UnityEngine.UI.Toggle/.colors.normalColor = #FFFFFFFF:UnityEngine.Color
Toggle:UnityEngine.UI.Toggle/.colors.highlightedColor = #F5F5F5FF:UnityEngine.Color
Toggle:UnityEngine.UI.Toggle/.colors.pressedColor = #C7C7C7FF:UnityEngine.Color
Toggle:UnityEngine.UI.Toggle/.colors.selectedColor = #F5F5F5FF:UnityEngine.Color
Toggle:UnityEngine.UI.Toggle/.colors.disabledColor = #999999CC:UnityEngine.Color

// UnityEngine.UI.Image 的默认色。
Image:UnityEngine.UI.Image/.color = #FFFFFFFF:UnityEngine.Color
